{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "API (http)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/backend/TradingTutor.API/bin/Debug/net10.0/TradingTutor.API.dll",
      "args": [],
      "cwd": "${workspaceFolder}/backend/TradingTutor.API",
      "stopAtEntry": false,
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:5014"
      }
    },
    {
      "name": "Frontend (Chrome)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/frontend"
    }
  ]
}
